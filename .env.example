# =============================================================================
# NearSea — contoh variabel environment (TEMPLATE, AMAN DI-COMMIT)
# Salin menjadi `.env` (lokal) atau isi via env server/CI. JANGAN commit `.env` asli.
# Daftar kanonik: docs/deployment/environments.md
#
# ATURAN: file ini HANYA berisi placeholder. Dilarang menaruh kredensial nyata
# (SEC-KEY-001). Nilai asli dibaca dari environment variable / secret store.
# =============================================================================

# --- PUBLIC (aman di frontend, prefix NEXT_PUBLIC_ di aplikasi FE) -----------
# Jaringan target: testnet | mainnet  (dev pakai testnet — lihat environments.md)
NEAR_NETWORK=testnet

# RPC utama + daftar fallback (urutan: FASTNEAR → official → dRPC)
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_RPC_FALLBACKS=https://test.rpc.fastnear.com,https://near-testnet.drpc.org

# Nilai yang benar-benar dibaca aplikasi Next.js: Next.js hanya mengekspos
# variabel ber-prefix NEXT_PUBLIC_ ke bundle browser (frontend-architecture.md §7).
# Salin nilai yang sama dari tiga variabel di atas.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://test.rpc.fastnear.com
NEXT_PUBLIC_NEAR_RPC_FALLBACKS=https://rpc.testnet.near.org

# Alamat kontrak (diisi saat deploy)
MARKET_CONTRACT_ID=market.<your-account>.testnet
FACTORY_CONTRACT_ID=factory.<your-account>.testnet

# Gateway IPFS baca (fase lanjut)
IPFS_GATEWAY=https://ipfs.io/ipfs/

# --- SECRET (hanya server/CI — DILARANG di repo/frontend) -------------------
# PostgreSQL report API
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>

# Session API (JWT) — generate acak, jangan pakai contoh ini
JWT_SECRET=<generate-random-secret>

# Alert admin via Telegram
TELEGRAM_BOT_TOKEN=<bot-token>
TELEGRAM_CHAT_ID=<chat-id>

# Object storage backup pg_dump
BACKUP_S3_ENDPOINT=<s3-endpoint>
BACKUP_S3_KEY=<access-key>
BACKUP_S3_SECRET=<secret-key>

# IPFS pinning (fase lanjut — saat fitur mint)
IPFS_PINNING_KEY=<pinning-provider-key>

# --- KHUSUS CI (bukan file .env) --------------------------------------------
# DEPLOY_SSH_KEY disimpan sebagai GitHub Secret, bukan di file ini.
